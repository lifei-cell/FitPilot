  "primary_key": {
    "name": "knowledge_document_pkey",
    "columns": [
      "id"
    ]
  },
  "unique_constraints": [
    {
      "name": "uk_knowledge_document_corpus_external",
      "columns": [
        "corpus_scope",
        "external_id"
      ]
    }
  ],
  "foreign_keys": [],
  "checks": [
    {
      "name": "knowledge_document_corpus_scope_check",
      "expression": "CHECK ((corpus_scope::text = ANY (ARRAY['live'::character varying, 'legacy-evaluation'::character varying]::text[])) OR corpus_scope::text ~ '^evaluation:[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'::text)"
    },
    {
      "name": "knowledge_document_format_check",
      "expression": "CHECK (format::text = ANY (ARRAY['MARKDOWN'::character varying, 'TEXT'::character varying]::text[]))"
    },
    {
      "name": "knowledge_document_index_slot_count_check",
      "expression": "CHECK (index_slot_count \u003e= 0)"
    },
    {
      "name": "knowledge_document_index_status_check",
      "expression": "CHECK (index_status::text = ANY (ARRAY['PENDING'::character varying, 'INDEXING'::character varying, 'INDEXED'::character varying, 'FAILED'::character varying]::text[]))"
    },
    {
      "name": "knowledge_document_lifecycle_status_check",
      "expression": "CHECK (lifecycle_status::text = ANY (ARRAY['ACTIVE'::character varying, 'EXPIRED'::character varying, 'REVOKED'::character varying, 'DELETE_PENDING'::character varying, 'DELETED'::character varying]::text[]))"
    },
    {
      "name": "knowledge_document_trust_level_check",
      "expression": "CHECK (trust_level::text = ANY (ARRAY['OFFICIAL'::character varying, 'INTERNAL'::character varying, 'PROFESSIONAL'::character varying, 'COMMUNITY'::character varying]::text[]))"
    }
  ],
  "indexes": [
    {
      "name": "idx_knowledge_document_category",
      "unique": false,
      "method": "btree",
      "elements": [
        {
          "position": 1,
          "column": "category"
        }
      ]
    },
    {
      "name": "idx_knowledge_document_index_retry",
      "unique": false,
      "method": "btree",
      "elements": [
        {
          "position": 1,
          "column": "index_status"
        },
        {
          "position": 2,
          "column": "updated_at"
        }
      ],
      "predicate": "index_status::text = ANY (ARRAY['PENDING'::character varying, 'FAILED'::character varying]::text[])"
    },
    {
      "name": "idx_knowledge_document_retrievable",
      "unique": false,
      "method": "btree",
      "elements": [
        {
          "position": 1,
          "column": "lifecycle_status"
        },
        {
          "position": 2,
          "column": "expires_at"
        },
        {
          "position": 3,
          "column": "category"
        }
      ]
    },
    {
