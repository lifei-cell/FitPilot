      "unique": true,
      "primary": true,
      "method": "btree",
      "elements": [
        {
          "position": 1,
          "column": "id"
        }
      ]
    },
    {
      "name": "uk_knowledge_document_corpus_external",
      "unique": true,
      "method": "btree",
      "elements": [
        {
          "position": 1,
          "column": "corpus_scope"
        },
        {
          "position": 2,
          "column": "external_id"
        }
      ]
    }
  ]
