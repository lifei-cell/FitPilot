DB_NAME=fitpilot
DB_USERNAME=fitpilot
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
IDEMPOTENCY_ENABLED=true
EVENTS_ENABLED=true
EVENT_OPERATIONS_TOKEN=replace-with-a-random-operations-token
OPERATIONS_TOKEN=replace-with-one-random-token-for-all-operations-apis
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
TRACING_SAMPLING_PROBABILITY=1.0
RAG_OPERATIONS_TOKEN=replace-with-a-random-operations-token
AGENT_OPERATIONS_TOKEN=replace-with-a-random-operations-token
LLM_ENABLED=false
# Full OpenAI-compatible /chat/completions endpoint. Keep keys out of Git.
LLM_PRIMARY_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_SMALL_MODEL=
LLM_PRIMARY_MEDIUM_MODEL=
LLM_PRIMARY_STRONG_MODEL=
LLM_FALLBACK_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_SMALL_MODEL=
LLM_FALLBACK_MEDIUM_MODEL=
LLM_FALLBACK_STRONG_MODEL=
RAG_ENABLED=true
EMBEDDING_PROVIDER=LOCAL
# Production can use an OpenAI-compatible endpoint returning 384 dimensions.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
