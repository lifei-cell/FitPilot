DB_NAME=fitpilot
DB_USERNAME=fitpilot
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
IDEMPOTENCY_ENABLED=true
EVENTS_ENABLED=true
EVENT_OPERATIONS_TOKEN=replace-with-a-random-operations-token
RAG_OPERATIONS_TOKEN=replace-with-a-random-operations-token
RAG_ENABLED=true
EMBEDDING_PROVIDER=LOCAL
# Production can use an OpenAI-compatible endpoint returning 384 dimensions.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
